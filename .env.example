# Variables lues par docker-compose (copier en .env à la racine).
# Les autres réglages (Stripe, SMTP, admin, facturation…) vont dans backend/.env.
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
DB_EXPOSED_PORT=3307
BACKEND_PORT=3000
DB_NAME=coworking
DB_USER=coworking
DB_PASSWORD=coworking
DB_ROOT_PASSWORD=rootpassword
DB_SYNCHRONIZE=true
JWT_SECRET=change-me-in-production
