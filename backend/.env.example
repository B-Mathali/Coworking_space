# Copier ce fichier en .env puis adapter les valeurs.

PORT=3000
FRONTEND_URL=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coworking
DB_SYNCHRONIZE=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@coworking.tn
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Administrateur

# --- Emails (mot de passe oublié, notifications de réservation) ---
# Laisser SMTP_HOST vide en local : le contenu des emails, liens compris, s'affiche dans la console du backend.
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CoworkSpace <no-reply@coworking.tn>

# --- Paiement Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
# Optionnel en local : donné par `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=

# --- Facturation ---
# Devise Stripe (tnd, eur, usd…) : garder la même que `currency` dans frontend/src/environments
PAYMENT_CURRENCY=tnd
VAT_RATE=0.19
APP_TIMEZONE=Africa/Tunis
COMPANY_NAME=CoworkSpace
COMPANY_ADDRESS=Tunis, Tunisie
COMPANY_EMAIL=contact@coworking.tn
# Matricule fiscal affiché sur les factures
COMPANY_TAX_ID=
